<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent" android:layout_height="match_parent"
	android:orientation="vertical" android:background="#FFFFFF">
	<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
		<Button android:id="@+id/printTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="PRINT" />
		<Button android:id="@+id/printerTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="PRINTER" />
	</LinearLayout>

	<LinearLayout android:id="@+id/printPage" android:layout_width="match_parent" android:layout_height="0dp"
		android:layout_weight="1" android:orientation="vertical" android:padding="8dp">
		<RadioGroup android:id="@+id/sizeGroup" android:layout_width="match_parent" android:layout_height="46dp"
			android:gravity="center_vertical" android:orientation="horizontal">
			<RadioButton android:id="@+id/sizeSmall" android:layout_width="0dp" android:layout_height="46dp"
				android:layout_weight="1" android:text="Small" />
			<RadioButton android:id="@+id/sizeMedium" android:layout_width="0dp" android:layout_height="46dp"
				android:layout_weight="1" android:checked="true" android:text="Medium" />
			<RadioButton android:id="@+id/sizeLarge" android:layout_width="0dp" android:layout_height="46dp"
				android:layout_weight="1" android:text="Large" />
		</RadioGroup>

		<LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
			android:gravity="center_vertical" android:orientation="horizontal">
			<ToggleButton android:id="@+id/boldToggle" android:layout_width="90dp" android:layout_height="44dp"
				android:textOff="Regular" android:textOn="Bold" />
			<CheckBox android:id="@+id/borderCheck" android:layout_width="wrap_content" android:layout_height="44dp"
				android:checked="true" android:text="Border" />
			<Button android:id="@+id/hideKeyboardButton" android:layout_width="0dp" android:layout_height="44dp"
				android:layout_weight="1" android:minWidth="0dp" android:text="HIDE KEYS" android:textSize="11sp" />
			<Button android:id="@+id/printButton" android:layout_width="72dp" android:layout_height="44dp"
				android:minWidth="0dp" android:padding="2dp" android:text="PRINT" />
		</LinearLayout>

		<EditText android:id="@+id/textInput" android:layout_width="match_parent" android:layout_height="0dp"
			android:layout_weight="1" android:background="@drawable/editor_border" android:gravity="top|start"
			android:hint="Type or paste formatted text here" android:inputType="textCapSentences|textMultiLine"
			android:padding="12dp" android:scrollbars="vertical" android:textColor="#000000"
			android:textColorHint="#555555" android:textSize="32px" />
		<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="36dp"
			android:gravity="center" android:text="Formatting applies to new text" android:textColor="#000000" android:textSize="15sp" />
	</LinearLayout>

	<LinearLayout android:id="@+id/printerPage" android:layout_width="match_parent" android:layout_height="0dp"
		android:layout_weight="1" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
		<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
			android:text="Paired printer" android:textColor="#000000" android:textSize="22sp" android:textStyle="bold" />
		<Spinner android:id="@+id/printerSpinner" android:layout_width="match_parent" android:layout_height="64dp" />
		<Button android:id="@+id/refreshPrintersButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="REFRESH PAIRED PRINTERS" />
		<TextView android:id="@+id/printerDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
			android:layout_marginTop="20dp" android:textColor="#000000" android:textSize="18sp" />
		<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
			android:text="Pair the printer in the phone's Bluetooth settings before selecting it here."
			android:textColor="#000000" android:textSize="16sp" />
	</LinearLayout>
</LinearLayout>
