<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="24dp"
	android:background="#FFFFFF">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Simple Print"
		android:textColor="#000000"
		android:textSize="24sp"
		android:textStyle="bold" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:text="Paired printer"
		android:textColor="#000000"
		android:textSize="18sp" />

	<Spinner
		android:id="@+id/printerSpinner"
		android:layout_width="match_parent"
		android:layout_height="56dp" />

	<EditText
		android:id="@+id/textInput"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:layout_marginTop="12dp"
		android:background="@android:drawable/edit_text"
		android:gravity="top|start"
		android:hint="Type or paste text"
		android:inputType="textCapSentences|textMultiLine"
		android:minLines="4"
		android:padding="12dp"
		android:textColor="#000000"
		android:textColorHint="#555555"
		android:textSize="20sp" />

	<RadioGroup
		android:id="@+id/sizeGroup"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<RadioButton android:id="@+id/sizeSmall" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Small" />
		<RadioButton android:id="@+id/sizeMedium" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:checked="true" android:text="Medium" />
		<RadioButton android:id="@+id/sizeLarge" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Large" />
	</RadioGroup>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<RadioGroup
			android:id="@+id/styleGroup"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="horizontal">
			<RadioButton android:id="@+id/styleRegular" android:layout_width="wrap_content" android:layout_height="48dp" android:checked="true" android:text="Regular" />
			<RadioButton android:id="@+id/styleBold" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Bold" />
		</RadioGroup>
		<CheckBox
			android:id="@+id/borderCheck"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:checked="true"
			android:text="Border" />
	</LinearLayout>

	<Button
		android:id="@+id/printButton"
		android:layout_width="match_parent"
		android:layout_height="64dp"
		android:text="PRINT"
		android:textSize="20sp" />

	<TextView
		android:id="@+id/statusText"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:gravity="center"
		android:text="Ready"
		android:textColor="#000000"
		android:textSize="18sp" />
</LinearLayout>
